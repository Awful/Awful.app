# Build script working folder
/build.noindex/

# Screenshot matrix output — captures, collage sheets, slideshow videos and the
# generated index. All of it is regenerable from Scripts/screenshot-matrix/,
# which is tracked. Ignoring the whole directory rather than listing extensions:
# it holds gigabytes of PNG and MP4, and a rule per type missed the videos.
/ScreenshotMatrix/

# Bundler local install
/.bundle/
/Vendor/bundle/

# Local config for things that shouldn't be checked into a shared repo (see README.md for suggestions).
/Local.entitlements
/Local.xcconfig

# macOS and Xcode junk
.DS_Store
xcuserdata
/Awful.xcworkspace/xcshareddata/Awful.xccheckout
/DerivedData/

# Optional CSS compiler possible location
/node_modules/

# Swift Package Manager
/.build/
/.swiftpm/
/Package.resolved
